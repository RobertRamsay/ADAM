+{
+    var _cols = 5;
+    var _cell = floor((_w - (_cols - 1) * 6) / _cols);
+    var _n = array_length(proj.tiles);
+    for (var i = 0; i < _n; i++)
+    {
+        var _gx = _x + (i mod _cols) * (_cell + 6);
+        var _gy = _y + (i div _cols) * (_cell + 6);
+        var _t = proj.tiles[i];
+        var _what = "";
