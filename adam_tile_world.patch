+        else { _what += "see-through"; }
+        if (_t.dig) { _what += ", can be dug"; }
+        if (_t.goal) { _what += ", counts for the goal"; }
+        var _hot = ui_register(_id + string(i), _gx, _gy, _gx + _cell, _gy + _cell, string(i) + ": " + _t.name + "|Click to pick this tile (" + _what + ").");
