+++ b/scripts/scr_amiga_machine_profiles/scr_amiga_machine_profiles.gml
@@ -0,0 +1,124 @@
+/// ADAM — stock target machine profiles.
+///
+/// Every build, the emulator launch and (later) every no-code block reads its
+/// hardware limits from the active profile rather than hard-coding a chipset.
+/// Two stock machines are offered at launch:
+///
+///   A500_600 : OCS/ECS, MC68000 @ 7 MHz, 1MB chip RAM, no fast RAM
+///   A1200    : AGA,     MC68EC020 @ 14 MHz, 2MB chip RAM, no fast RAM
+///
+/// The A500/600 profile is emulated as a stock A600 (ECS Agnus, 1MB chip) —
+/// the common denominator that both a 1MB A500 and an A600 owner can run.
+
+
+/// @desc scr_amiga_define_machine_profiles()
+/// Builds global.machine_profiles. Called once from obj_amiga_manager Create.
+function scr_amiga_define_machine_profiles() {
+    global.machine_profiles = [
+        {
+            id                  : "A500_600",
+            name                : "AMIGA 500/600",
+            short_name          : "A500/600 1MB",
+            chipset             : "ECS",
+            chipset_label       : "OCS / ECS",
+            cpu_label           : "MC68000 @ 7.09 MHz",
+            chip_kb             : 1024,
+            slow_kb             : 0,
+            fast_kb             : 0,
+            ram_label           : "1MB CHIP RAM",
+            colour_label        : "32 COLOURS (64 EHB / 4096 HAM6)",
+            palette_bits        : 12,
+            max_bitplanes_lores : 6,
+            palette_registers   : 32,
+            fsuae_model         : "A600"
+        },
+        {
+            id                  : "A1200",
+            name                : "AMIGA 1200",
+            short_name          : "A1200 2MB",
+            chipset             : "AGA",
+            chipset_label       : "AGA",
+            cpu_label           : "MC68EC020 @ 14.18 MHz",
+            chip_kb             : 2048,
+            slow_kb             : 0,
+            fast_kb             : 0,
+            ram_label           : "2MB CHIP RAM",
+            colour_label        : "256 COLOURS (262144 HAM8)",
+            palette_bits        : 24,
+            max_bitplanes_lores : 8,
+            palette_registers   : 256,
+            fsuae_model         : "A1200"
+        }
+    ];
+}
+
+
+/// @desc scr_amiga_find_machine_profile(_id)
+/// Returns the profile struct for _id, or undefined when no profile matches.
+function scr_amiga_find_machine_profile(_id) {
+    var _count = array_length(global.machine_profiles);
+    var _i = 0;
+
+    while (_i < _count) {
+        if (global.machine_profiles[_i].id == _id) {
+            return global.machine_profiles[_i];
+        }
+        _i += 1;
+    }
+
+    return undefined;
+}
+
+
+/// @desc scr_amiga_set_machine(_id, _mark_dirty)
+/// Makes _id the active target. Unknown ids fall back to the first profile.
+/// _mark_dirty is true only when the user changes machine mid-session, so the
+/// workspace (which stores machine_id) is flagged for saving.
+function scr_amiga_set_machine(_id, _mark_dirty) {
+    var _profile = scr_amiga_find_machine_profile(_id);
+
+    if (_profile == undefined) {
+        _profile = global.machine_profiles[0];
+    }
+
+    global.current_machine = _profile;
+    global.current_machine_id = _profile.id;
+    global.current_chipset_mode = _profile.chipset;
+
+    ini_open("settings.ini");
+    ini_write_string("machine", "last", _profile.id);
+    ini_close();
+
+    if (_mark_dirty) {
+        scr_mark_workspace_dirty();
+    }
+}
+
+
+/// @desc scr_amiga_read_last_machine_id()
+/// The machine chosen last session, used as the launch picker's highlight.
+function scr_amiga_read_last_machine_id() {
+    ini_open("settings.ini");
+    var _last_id = ini_read_string("machine", "last", "A1200");
+    ini_close();
+
+    if (scr_amiga_find_machine_profile(_last_id) == undefined) {
+        _last_id = global.machine_profiles[0].id;
+    }
+
+    return _last_id;
+}
+
+
+/// @desc scr_amiga_open_machine_select(_mark_dirty)
+/// Opens the machine picker. _mark_dirty is false for the launch picker and
+/// true when reopened from the MACHINE button.
+function scr_amiga_open_machine_select(_mark_dirty) {
+    if (instance_exists(obj_machine_select)) {
+        exit;
+    }
+
+    var _picker = instance_create_depth(0, 0, -400000, obj_machine_select);
+    _picker.picker_mark_dirty = _mark_dirty;
+    _picker.picker_is_launch = !_mark_dirty;
+}
