diff --git a/objects/obj_machine_select/Create_0.gml b/objects/obj_machine_select/Create_0.gml
new file mode 100644
index 0000000..a19421f
--- /dev/null
+++ b/objects/obj_machine_select/Create_0.gml
@@ -0,0 +1,60 @@
+/// @description ADAM — target machine picker (modal)
+/// Shown at launch once the logo splash has faded, and again whenever the
+/// MACHINE button in the top strip is clicked. While it exists, the manager,
+/// nodes and palette treat it like any other modal editor.
+
+depth = -400000;
+
+// Set by scr_amiga_open_machine_select straight after creation.
+picker_mark_dirty = false;
+picker_is_launch = true;
+
+picker_visible = false;
+picker_alpha = 0;
+
+// Ignore the click that opened the picker.
+picker_input_delay = 3;
+
+picker_card_width = 560;
+picker_card_height = 330;
+picker_card_gap = 60;
+picker_card_y = (room_height / 2) - (picker_card_height / 2);
+picker_card_x = [];
+
+var _total_width = (picker_card_width * array_length(global.machine_profiles))
+    + (picker_card_gap * (array_length(global.machine_profiles) - 1));
+var _first_x = (room_width / 2) - (_total_width / 2);
+var _c = 0;
+
+while (_c < array_length(global.machine_profiles)) {
+    array_push(picker_card_x, _first_x + (_c * (picker_card_width + picker_card_gap)));
+    _c += 1;
+}
+
+picker_hover_index = -1;
+picker_highlight_index = 0;
+
+var _last_id = scr_amiga_read_last_machine_id();
+var _h = 0;
+
+while (_h < array_length(global.machine_profiles)) {
+    if (global.machine_profiles[_h].id == _last_id) {
+        picker_highlight_index = _h;
+    }
+    _h += 1;
+}
+
+picker_choose = function(_index) {
+    var _profile = global.machine_profiles[_index];
+    var _changed = (_profile.id != global.current_machine_id);
+
+    if (picker_is_launch) {
+        global.launch_machine_id = _profile.id;
+        scr_amiga_set_machine(_profile.id, false);
+    } else {
+        scr_amiga_set_machine(_profile.id, picker_mark_dirty && _changed);
+    }
+
+    scr_set_status_message("TARGET: " + _profile.name + "  (" + _profile.chipset_label + ", " + _profile.ram_label + ")", make_colour_rgb(0, 255, 255));
+    instance_destroy();
+};
diff --git a/objects/obj_machine_select/Draw_0.gml b/objects/obj_machine_select/Draw_0.gml
new file mode 100644
index 0000000..71118cb
--- /dev/null
+++ b/objects/obj_machine_select/Draw_0.gml
@@ -0,0 +1,107 @@
+if (!picker_visible) {
+    exit;
+}
+
+draw_set_font(font_CyberVerse);
+draw_set_halign(fa_left);
+draw_set_valign(fa_top);
+
+// Dim everything behind the picker.
+draw_set_alpha(0.82 * picker_alpha);
+draw_set_colour(c_black);
+draw_rectangle(0, 0, room_width, room_height, false);
+draw_set_alpha(picker_alpha);
+
+var _title_y = picker_card_y - 90;
+
+draw_set_halign(fa_center);
+draw_set_colour(make_colour_rgb(255, 136, 0));
+draw_text_transformed(room_width / 2, _title_y, "ADAM", 2, 2, 0);
+draw_set_colour(c_white);
+draw_text(room_width / 2, _title_y + 44, "SELECT TARGET MACHINE");
+draw_set_halign(fa_left);
+
+var _c = 0;
+
+while (_c < array_length(global.machine_profiles)) {
+    var _profile = global.machine_profiles[_c];
+    var _x1 = picker_card_x[_c];
+    var _y1 = picker_card_y;
+    var _x2 = _x1 + picker_card_width;
+    var _y2 = _y1 + picker_card_height;
+    var _is_highlight = (_c == picker_highlight_index);
+    var _is_current = (_profile.id == global.current_machine_id);
+
+    // Card body.
+    var _body_colour = make_colour_rgb(22, 28, 48);
+    if (_is_highlight) {
+        _body_colour = make_colour_rgb(38, 52, 92);
+    }
+    draw_set_colour(_body_colour);
+    draw_rectangle(_x1, _y1, _x2, _y2, false);
+
+    // Workbench-style title bar.
+    var _bar_colour = make_colour_rgb(0, 85, 170);
+    if (_is_highlight) {
+        _bar_colour = make_colour_rgb(255, 136, 0);
+    }
+    draw_set_colour(_bar_colour);
+    draw_rectangle(_x1, _y1, _x2, _y1 + 34, false);
+
+    // Border.
+    var _border_colour = make_colour_rgb(110, 120, 160);
+    if (_is_highlight) {
+        _border_colour = c_white;
+    }
+    draw_set_colour(_border_colour);
+    draw_rectangle(_x1, _y1, _x2, _y2, true);
+    draw_rectangle(_x1 + 1, _y1 + 1, _x2 - 1, _y2 - 1, true);
+
+    // Heading.
+    draw_set_colour(c_white);
+    draw_text(_x1 + 14, _y1 + 8, string(_c + 1) + ".  " + _profile.name);
+
+    if (_is_current && !picker_is_launch) {
+        draw_set_halign(fa_right);
+        draw_text(_x2 - 14, _y1 + 8, "CURRENT");
+        draw_set_halign(fa_left);
+    }
+
+    // Spec rows.
+    var _row_y = _y1 + 58;
+    var _label_x = _x1 + 18;
+    var _value_x = _x1 + 170;
+
+    draw_set_colour(make_colour_rgb(150, 160, 200));
+    draw_text(_label_x, _row_y, "CHIPSET");
+    draw_text(_label_x, _row_y + 34, "CPU");
+    draw_text(_label_x, _row_y + 68, "MEMORY");
+    draw_text(_label_x, _row_y + 102, "COLOURS");
+    draw_text(_label_x, _row_y + 136, "BITPLANES");
+    draw_text(_label_x, _row_y + 170, "EMULATED AS");
+
+    draw_set_colour(c_white);
+    draw_text(_value_x, _row_y, _profile.chipset_label);
+    draw_text(_value_x, _row_y + 34, _profile.cpu_label);
+    draw_text(_value_x, _row_y + 68, _profile.ram_label + "  (STOCK, NO FAST RAM)");
+    draw_text(_value_x, _row_y + 102, _profile.colour_label);
+    draw_text(_value_x, _row_y + 136, string(_profile.max_bitplanes_lores) + " (LORES)");
+    draw_text(_value_x, _row_y + 170, "FS-UAE " + _profile.fsuae_model);
+
+    _c += 1;
+}
+
+// Footer hint.
+var _hint = "CLICK A MACHINE  -  OR PRESS 1 / 2  -  ARROWS + ENTER";
+if (!picker_is_launch) {
+    _hint = _hint + "  -  RIGHT-CLICK TO CANCEL";
+}
+
+draw_set_halign(fa_center);
+draw_set_colour(make_colour_rgb(150, 160, 200));
+draw_text(room_width / 2, picker_card_y + picker_card_height + 30, _hint);
+draw_text(room_width / 2, picker_card_y + picker_card_height + 54, "THE MACHINE CAN BE CHANGED LATER FROM THE TOP BAR");
+
+draw_set_halign(fa_left);
+draw_set_alpha(1);
+draw_set_colour(c_white);
diff --git a/objects/obj_machine_select/Step_0.gml b/objects/obj_machine_select/Step_0.gml
new file mode 100644
index 0000000..7a9b9a0
--- /dev/null
+++ b/objects/obj_machine_select/Step_0.gml
@@ -0,0 +1,69 @@
+// Stay hidden and inert until the startup logo has faded out.
+if (instance_exists(obj_flashSplash)) {
+    if (obj_flashSplash.fade > 0) {
+        picker_visible = false;
+        exit;
+    }
+}
+
+picker_visible = true;
+
+if (picker_alpha < 1) {
+    picker_alpha = min(1, picker_alpha + 0.08);
+}
+
+if (picker_input_delay > 0) {
+    picker_input_delay -= 1;
+    exit;
+}
+
+// Hover / click.
+picker_hover_index = -1;
+var _c = 0;
+
+while (_c < array_length(picker_card_x)) {
+    var _x1 = picker_card_x[_c];
+    var _y1 = picker_card_y;
+
+    if (point_in_rectangle(mouse_x, mouse_y, _x1, _y1, _x1 + picker_card_width, _y1 + picker_card_height)) {
+        picker_hover_index = _c;
+        picker_highlight_index = _c;
+    }
+    _c += 1;
+}
+
+if (picker_hover_index != -1 && mouse_check_button_pressed(mb_left)) {
+    picker_choose(picker_hover_index);
+    exit;
+}
+
+// Keyboard: 1 / 2 pick directly, LEFT / RIGHT move, ENTER confirms.
+if (keyboard_check_pressed(ord("1"))) {
+    picker_choose(0);
+    exit;
+}
+
+if (keyboard_check_pressed(ord("2"))) {
+    if (array_length(global.machine_profiles) > 1) {
+        picker_choose(1);
+        exit;
+    }
+}
+
+if (keyboard_check_pressed(vk_left)) {
+    picker_highlight_index = max(0, picker_highlight_index - 1);
+}
+
+if (keyboard_check_pressed(vk_right)) {
+    picker_highlight_index = min(array_length(global.machine_profiles) - 1, picker_highlight_index + 1);
+}
+
+if (keyboard_check_pressed(vk_enter)) {
+    picker_choose(picker_highlight_index);
+    exit;
+}
+
+// Reopened from the MACHINE button: right-click backs out unchanged.
+if (!picker_is_launch && mouse_check_button_pressed(mb_right)) {
+    instance_destroy();
+}
