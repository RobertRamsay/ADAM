+++ b/scripts/scr_load_workspace_from_path/scr_load_workspace_from_path.gml
@@ -115,6 +115,17 @@ function scr_load_workspace_from_path(_path) {
         global.asset_list = _save_data.assets;
     }
 
+    // Workspaces saved before machine profiles existed carry no machine_id
+    // and simply keep the current machine.
+    var _saved_machine_id = _save_data[$ "machine_id"];
+
+    if (is_string(_saved_machine_id)) {
+        if (_saved_machine_id != global.current_machine_id) {
+            scr_amiga_set_machine(_saved_machine_id, false);
+            scr_set_status_message("Workspace targets " + global.current_machine.name + " - machine switched.", make_colour_rgb(0, 255, 255));
+        }
+    }
+
     global.workspace_dirty = false;
     show_debug_message("Loaded workspace from " + _path);
 }
