-.restore    moveq   #0,d0
+.restore    tst.l   H_GRAD(a4)
+            beq.s   .plain
+            move.w  v_gradfix(a5),d1
+            bra     build_grad
+.plain      moveq   #0,d0
             move.l  v_bg(a5),d1
             bra     setcol
 .r          rts
 
+; ============================================================================
+;  copper sky: COLOR00 changes on every display line
+;  d1.w = -1 : use the gradient table      d1.w = $0RGB : one fixed colour
+; ============================================================================
+build_grad:
+            movem.l d0-d4/a0-a1,-(sp)
+            lea     cop_grad(pc),a0
+            move.l  H_GRAD(a4),d0
+            beq.s   .off
+            lea     0(a4,d0.l),a1
+            move.w  #$0180,(a0)+            ; top border = first colour
+            move.w  (a1),d2
+            tst.w   d1
+            bmi.s   .top
+            move.w  d1,d2
+.top        move.w  d2,(a0)+
+            moveq   #0,d3                   ; line index
+.line       move.w  d3,d4
+            add.w   #$2c,d4
+            cmp.w   #$100,d4                ; past line 255: wait for the wrap
+            bne.s   .w
+            move.l  #$ffdffffe,(a0)+
+.w          lsl.w   #8,d4
+            or.w    #$07,d4
+            move.w  d4,(a0)+
+            move.w  #$fffe,(a0)+
+            move.w  #$0180,(a0)+
+            bsr.s   .col
+            move.w  d2,(a0)+
+            addq.w  #1,d3
+            cmp.w   #256,d3
+            blt.s   .line
+.off        move.l  #$fffffffe,(a0)+
+            movem.l (sp)+,d0-d4/a0-a1
+            rts
+.col        move.w  (a1)+,d2                ; next table colour, or the fixed one
+            tst.w   d1
+            bmi.s   .t
+            move.w  d1,d2
+.t          rts
+
+; 24-bit $00RRGGBB in d1 -> 12-bit $0RGB in d4
+rgb12:      move.l  d3,-(sp)
+            move.l  d1,d3
+            lsr.l   #8,d3
+            lsr.l   #4,d3
+            and.w   #$0f00,d3
+            move.w  d3,d4
+            move.l  d1,d3
+            lsr.l   #8,d3
+            and.w   #$00f0,d3
+            or.w    d3,d4
+            move.l  d1,d3
+            lsr.l   #4,d3
+            and.w   #$000f,d3
+            or.w    d3,d4
+            move.l  (sp)+,d3
+            rts
+
 ; ============================================================================
 ;  Paula sound effects - one shot, channel = sound number AND 3
 ; ============================================================================
@@ -1001,7 +1126,10 @@ play_sfx:
             add.w   d4,a1
             move.l  d1,(a1)                 ; AUDxLC
             move.w  d2,4(a1)                ; AUDxLEN
-            move.w  #SFX_PERIOD,6(a1)       ; AUDxPER
+            move.w  6(a0),d4                ; per-sound period (sampled sounds)
+            bne.s   .per
+            move.w  #SFX_PERIOD,d4
+.per        move.w  d4,6(a1)                ; AUDxPER
             move.w  #64,8(a1)               ; AUDxVOL
             lea     v_spend(a5),a2
             add.w   d3,d3
@@ -1168,7 +1296,8 @@ cop_spr:    dc.w    $0120,0,$0122,0
             dc.w    $0134,0,$0136,0
             dc.w    $0138,0,$013a,0
             dc.w    $013c,0,$013e,0
-            dc.w    $ffff,$fffe
+cop_grad:   dc.w    $ffff,$fffe             ; sky lines are built here at run time
+            ds.b    256*8+16
 
             cnop    0,4
 V:          ds.b    V_SIZE
