+            moveq   #88,d2
+            bsr     big_text
+            lea     str_fire(pc),a0
+            moveq   #16,d2
+            bsr     centre_text
+            bsr     wait_fire
+            bsr     restore_backdrop
+level_start:
+            bsr     init_actors
+            bsr     clear_latches
