+            beq.s   .notitle
+            move.l  d0,a0
+            tst.w   G_TITLE(a0)
+            beq.s   .notitle
+            lea     G_TITLE1(a0),a0
+            moveq   #72,d2
+            bsr     big_text
+            move.l  v_game(a5),a0
+            lea     G_TITLE2(a0),a0
+            moveq   #16,d2
+            bsr     centre_text
+            bsr     wait_fire
+.notitle    moveq   #5,d0                   ; 'the game starts' rules
+            bsr     run_when_rules
+            bra.s   level_card
+
+; next level: show which one is coming, then play it
+level_next: addq.w  #1,v_level(a5)
+level_card: lea     stack_top(pc),a7
+            move.w  #$000f,$96(a6)
