             move.w  R_VAL(a3),d0
             add.l   v_score(a5),d0
@@ -869,6 +1057,7 @@ act_flash:  move.w  #16,v_flash(a5)
 
 act_home:   cmp.w   H_NACT(a4),d4
             bhs     act_none
+            bsr     stop_fall
             bsr     actor_rec
             move.w  A_X(a0),v_ax(a5,d5.w)
             move.w  A_Y(a0),v_ay(a5,d5.w)
@@ -876,6 +1065,7 @@ act_home:   cmp.w   H_NACT(a4),d4
 
