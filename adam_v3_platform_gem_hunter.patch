             bsr     place_sprites
             bsr     run_rules
             bsr     sound_tick
@@ -423,6 +439,12 @@ move_actors:
             add.w   d5,d5
             move.w  A_ROLE(a2),d0
             beq.s   .player
+            cmp.w   #6,d0
+            beq     .platform
+            cmp.w   #7,d0
+            beq     .hopper
+            cmp.w   #8,d0
+            beq     .faller
             cmp.w   #4,d0
             beq     .chaser
             cmp.w   #3,d0
@@ -500,17 +522,17 @@ move_actors:
             moveq   #0,d0
             move.w  #0,v_dy(a5,d5.w)
