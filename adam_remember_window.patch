+            var _ww2 = window_get_width();
+            var _wh2 = window_get_height();
+            if (_wx != wsave_x || _wy != wsave_y || _ww2 != wsave_w || _wh2 != wsave_h)
+            {
+                wsave_x = _wx;
+                wsave_y = _wy;
+                wsave_w = _ww2;
+                wsave_h = _wh2;
+                _changed = true;
+            }
+        }
+        if (_changed) { settings_save(); }
+    }
 }
