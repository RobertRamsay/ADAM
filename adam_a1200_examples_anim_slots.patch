+    _s.anims[_k].frames = _fr;
+    _s.anims[_k].rate = clamp(_rate, 2, 30);
+    var _m = _mode;
+    if (_m == 3) { _m = 0; }
+    _s.anims[_k].mode = clamp(_m, 0, 2);
+    anim_sel = _k;
+    anim_slot = 0;
+    anim_t0 = current_time;
