diff --git a/datafiles/engine/engine.s b/datafiles/engine/engine.s
new file mode 100644
index 0000000..8acec27
--- /dev/null
+++ b/datafiles/engine/engine.s
@@ -0,0 +1,1179 @@
+; ============================================================================
+;  ADAM runtime engine  -  Polytricity 2026
+;
+;  A fixed, data-driven 68000 engine.  ADAM never generates code: it appends
+;  the game data block (header, palette, backdrop, actors, rules, sounds)
+;  straight after this binary and the engine reads it at data_start.
+;
+;  Position independent - loaded anywhere in chip RAM by the ADAM bootblock.
+;  Assemble:  vasmm68k_mot -Fbin -pic -m68000 -no-opt -o engine.bin engine.s
+;
+;  Registers held for the whole run:
+;     a4 = data_start (game data block)
+;     a5 = V          (engine variables)
+;     a6 = $dff000    (custom chips)
+; ============================================================================
+
+; ---------------- game data header (offsets from data_start) ----------------
+H_MAGIC     equ 0
+H_VERSION   equ 4
+H_FLAGS     equ 6          ; bit 0 = AGA machine
+H_DEPTH     equ 8          ; backdrop bitplanes 1..8
+H_NACT      equ 10
+H_NRULE     equ 12
+H_LIVES     equ 14
+H_SHOWSC    equ 16
+H_SHOWLV    equ 18
+H_HUDROW    equ 20         ; text row 0..31
+H_HUDCOL    equ 22         ; palette index
+H_MSGCOL    equ 24         ; palette index
+H_PLAYER    equ 26         ; actor index or -1
+H_PAL       equ 32         ; offset: palette, (1<<depth) longs $00RRGGBB
+H_PLANES    equ 36         ; offset: pristine backdrop, depth * 10240 bytes
+H_ACTORS    equ 40         ; offset: actor records
+H_RULES     equ 44         ; offset: rule records
+H_SFX       equ 48         ; offset: 8 sound entries
+H_TOVER     equ 52         ; offset: game over text (0 terminated)
+H_TWIN      equ 56         ; offset: win text (0 terminated)
+H_SPRCOL    equ 60         ; offset: 4 sprite pairs x 3 longs $00RRGGBB
+H_DISP      equ 64         ; offset: display bitplanes (depth * 10240 bytes)
+
+; actor record
+A_X         equ 0
+A_Y         equ 2
+A_ROLE      equ 4
+A_SPD       equ 6
+A_VIS       equ 8
+A_LEFT      equ 10
+A_UP        equ 12
+A_BX0       equ 14
+A_BY0       equ 16
+A_BX1       equ 18
+A_BY1       equ 20
+A_SPR       equ 22         ; long offset of this actor's hardware sprite block
+A_CHAN      equ 26         ; hardware sprite channel 0..7 (colour pair = channel / 2)
+ACT_SIZE    equ 32
+
+; rule record
+R_WHEN      equ 0
+R_A         equ 2
+R_B         equ 4
+R_N         equ 6
+R_ACT       equ 8
+R_TGT       equ 10
+R_VAL       equ 12
+RULE_SIZE   equ 16
+
+PLANE_SIZE  equ 10240      ; 320 x 256 / 8
+XMAX        equ 304        ; 320 - 16
+YMAX        equ 232        ; 256 - 24
+SPR_H       equ 24
+SFX_PERIOD  equ 322        ; ~11015 Hz on PAL
+SCORE_MAX   equ 99999
+
+; ---------------- engine variables (offsets from V) ----------------
+            rsreset
+v_ax        rs.w 8
+v_ay        rs.w 8
+v_spd       rs.w 8
+v_vis       rs.w 8
+v_dx        rs.w 8
+v_dy        rs.w 8
+v_joy       rs.w 1
+v_fcount    rs.w 1
+v_sectick   rs.w 1
+v_lives     rs.w 1
+v_score     rs.l 1
+v_flash     rs.w 1
+v_bg        rs.l 1
+v_rand      rs.l 1
+v_spend     rs.w 4
+v_disp      rs.l 1
+v_digits    rs.b 8
+v_opaque    rs.w 1
+v_latch     rs.w 128
+V_SIZE      rs.b 0
+
+; ============================================================================
+start:
+            lea     V(pc),a5
+            lea     data_start(pc),a4
+            lea     $dff000,a6
+            move.w  #$7fff,$9a(a6)          ; INTENA  - all interrupts off
+            move.w  #$7fff,$9c(a6)          ; INTREQ  - clear pending
+            move.w  #$7fff,$96(a6)          ; DMACON  - all DMA off
+            lea     stack_top(pc),a7
+            move.l  #$2a5b7c19,v_rand(a5)
+            bsr     init_display
+
+game_restart:
+            lea     stack_top(pc),a7
+            move.w  #$000f,$96(a6)          ; audio DMA off
+            bsr     restore_backdrop
+            bsr     init_palette
+            bsr     init_actors
+            bsr     clear_state
+            bsr     draw_hud
+            bsr     place_sprites
+            bsr     run_start_rules
+mainloop:
+            bsr     wait_vbl
+            bsr     frame
+            bra     mainloop
+
+; ============================================================================
+;  display set-up
+; ============================================================================
+init_display:
+            move.l  H_DISP(a4),d0
+            add.l   a4,d0
+            move.l  d0,v_disp(a5)
+
+            lea     cop_bpl(pc),a0          ; bitplane pointers
+            moveq   #7,d7
+.bpl        swap    d0
+            move.w  d0,2(a0)
+            swap    d0
+            move.w  d0,6(a0)
+            add.l   #PLANE_SIZE,d0
+            addq.l  #8,a0
+            dbf     d7,.bpl
+
+            lea     cop_spr(pc),a0          ; sprite pointers: all null first
+            lea     null_spr(pc),a1
+            move.l  a1,d0
+            swap    d0
+            moveq   #7,d7
+.null       move.w  d0,2(a0)
+            swap    d0
+            move.w  d0,6(a0)
+            swap    d0
+            addq.l  #8,a0
+            dbf     d7,.null
+            move.w  H_NACT(a4),d6           ; then each actor on its channel
+            beq.s   .sprdone
+            subq.w  #1,d6
+            move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a2
+.spr        lea     cop_spr(pc),a0
+            move.w  A_CHAN(a2),d1
+            and.w   #7,d1
+            lsl.w   #3,d1
+            add.w   d1,a0
+            move.l  A_SPR(a2),d0
+            add.l   a4,d0
+            swap    d0
+            move.w  d0,2(a0)
+            swap    d0
+            move.w  d0,6(a0)
+            lea     ACT_SIZE(a2),a2
+            dbf     d6,.spr
+.sprdone
+            move.w  #$2c81,$8e(a6)          ; DIWSTRT
+            move.w  #$2cc1,$90(a6)          ; DIWSTOP  (320 x 256 PAL)
+            move.w  #$0038,$92(a6)          ; DDFSTRT
+            move.w  #$00d0,$94(a6)          ; DDFSTOP
+            move.w  #$0000,$102(a6)         ; BPLCON1
+            move.w  #$0024,$104(a6)         ; BPLCON2  - sprites in front
+            move.w  #$0000,$108(a6)         ; BPL1MOD
+            move.w  #$0000,$10a(a6)         ; BPL2MOD
+
+            move.w  H_DEPTH(a4),d0          ; BPLCON0
+            cmp.w   #8,d0
+            bne.s   .not8
+            move.w  #$0010,d1               ; 8 planes = BPU3 (AGA)
+            bra.s   .bpu
+.not8       move.w  d0,d1
+            lsl.w   #8,d1
+            lsl.w   #4,d1
+.bpu        or.w    #$0200,d1               ; COLOR on
+            btst    #0,H_FLAGS+1(a4)
+            beq.s   .ocs
+            or.w    #$0001,d1               ; ECSENA for BPLCON3 on AGA
+            move.w  d1,$100(a6)
+            move.w  #$0000,$1fc(a6)         ; FMODE   - OCS compatible fetch
+            move.w  #$0c00,$106(a6)         ; BPLCON3
+            move.w  #$00ff,$10c(a6)         ; BPLCON4 - sprite colours 240-255
+            bra.s   .cop
+.ocs        move.w  d1,$100(a6)
+.cop        lea     copper(pc),a0
+            move.l  a0,$80(a6)              ; COP1LC
+            move.w  d0,$88(a6)              ; COPJMP1 strobe
+            move.w  #$83a0,$96(a6)          ; DMAEN BPLEN COPEN SPREN
+            rts
+
+; ============================================================================
+;  wait for the bottom of the frame (line 300)
+; ============================================================================
+wait_vbl:
+.w1         move.l  $04(a6),d0
+            and.l   #$1ff00,d0
+            cmp.l   #$12c00,d0
+            bne.s   .w1
+.w2         move.l  $04(a6),d0
+            and.l   #$1ff00,d0
+            cmp.l   #$12c00,d0
+            beq.s   .w2
+            rts
+
+; ============================================================================
+;  game state
+; ============================================================================
+restore_backdrop:
+            move.l  H_PLANES(a4),d0
+            lea     0(a4,d0.l),a0
+            move.l  v_disp(a5),a1
+            move.w  H_DEPTH(a4),d7
+            mulu    #PLANE_SIZE/4,d7
+            subq.l  #1,d7
+.cp         move.l  (a0)+,(a1)+
+            dbf     d7,.cp
+            rts
+
+init_palette:
+            move.l  H_PAL(a4),d0
+            lea     0(a4,d0.l),a2
+            move.l  (a2),v_bg(a5)
+            move.w  H_DEPTH(a4),d6
+            moveq   #1,d5
+            lsl.w   d6,d5                   ; colour count
+            moveq   #0,d0
+.pal        move.l  (a2)+,d1
+            bsr     setcol
+            addq.w  #1,d0
+            cmp.w   d5,d0
+            blt.s   .pal
+
+            move.l  H_SPRCOL(a4),d0         ; sprite pair colours
+            lea     0(a4,d0.l),a2
+            moveq   #16,d4
+            btst    #0,H_FLAGS+1(a4)
+            beq.s   .base
+            move.w  #240,d4
+.base       moveq   #3,d6                   ; 4 pairs
+.pair       moveq   #2,d5                   ; 3 colours each
+            move.w  d4,d0
+            addq.w  #1,d0
+.pc         move.l  (a2)+,d1
+            bsr     setcol
+            addq.w  #1,d0
+            dbf     d5,.pc
+            addq.w  #4,d4
+            dbf     d6,.pair
+            rts
+
+init_actors:
+            move.w  H_NACT(a4),d6
+            beq.s   .done
+            move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a2
+            moveq   #0,d7
+.a          move.w  d7,d5
+            add.w   d5,d5
+            move.w  A_X(a2),v_ax(a5,d5.w)
+            move.w  A_Y(a2),v_ay(a5,d5.w)
+            move.w  A_SPD(a2),v_spd(a5,d5.w)
+            move.w  A_VIS(a2),v_vis(a5,d5.w)
+            move.w  A_LEFT(a2),v_dx(a5,d5.w)
+            move.w  A_UP(a2),v_dy(a5,d5.w)
+            lea     ACT_SIZE(a2),a2
+            addq.w  #1,d7
+            cmp.w   d6,d7
+            blt.s   .a
+.done       rts
+
+clear_state:
+            move.w  #0,v_fcount(a5)
+            move.w  #0,v_sectick(a5)
+            move.w  #0,v_flash(a5)
+            move.l  #0,v_score(a5)
+            move.w  H_LIVES(a4),v_lives(a5)
+            lea     v_spend(a5),a0
+            move.l  #0,(a0)+
+            move.l  #0,(a0)+
+            lea     v_latch(a5),a0
+            move.w  #127,d7
+.l          move.w  #0,(a0)+
+            dbf     d7,.l
+            move.w  $06(a6),d0              ; VHPOSR into the random seed
+            eor.w   d0,v_rand+2(a5)
+            tst.l   v_rand(a5)
+            bne.s   .r
+            move.l  #$2a5b7c19,v_rand(a5)
+.r          rts
+
+; ============================================================================
+;  colour register write
+;  d0.w = colour index 0..255   d1.l = $00RRGGBB
+; ============================================================================
+setcol:
+            movem.l d0-d4,-(sp)
+            move.w  d0,d2
+            and.w   #31,d2
+            add.w   d2,d2
+            add.w   #$180,d2                ; COLORxx register offset
+            move.l  d1,d3                   ; high nibbles -> $0RGB
+            lsr.l   #8,d3
+            lsr.l   #4,d3
+            and.w   #$0f00,d3
+            move.w  d3,d4
+            move.l  d1,d3
+            lsr.l   #8,d3
+            and.w   #$00f0,d3
+            or.w    d3,d4
+            move.l  d1,d3
+            lsr.l   #4,d3
+            and.w   #$000f,d3
+            or.w    d3,d4
+            btst    #0,H_FLAGS+1(a4)
+            bne.s   .aga
+            move.w  d4,0(a6,d2.w)
+            bra.s   .done
+.aga        move.w  d0,d3                   ; bank select
+            lsr.w   #5,d3
+            and.w   #7,d3
+            ror.w   #3,d3
+            or.w    #$0c00,d3
+            move.w  d3,$106(a6)
+            move.w  d4,0(a6,d2.w)           ; high nibbles
+            move.l  d1,d4                   ; low nibbles
+            lsr.l   #8,d4
+            and.w   #$0f00,d4
+            move.l  d1,d0
+            lsr.l   #4,d0
+            and.w   #$00f0,d0
+            or.w    d0,d4
+            move.w  d1,d0
+            and.w   #$000f,d0
+            or.w    d0,d4
+            or.w    #$0200,d3               ; LOCT
+            move.w  d3,$106(a6)
+            move.w  d4,0(a6,d2.w)
+            move.w  #$0c00,$106(a6)
+.done       movem.l (sp)+,d0-d4
+            rts
+
+; ============================================================================
+;  one frame of game
+; ============================================================================
+frame:
+            bsr     read_joy
+            move.w  #0,v_sectick(a5)
+            addq.w  #1,v_fcount(a5)
+            cmp.w   #50,v_fcount(a5)
+            blt.s   .f1
+            move.w  #0,v_fcount(a5)
+            move.w  #1,v_sectick(a5)
+.f1         bsr     move_actors
+            bsr     place_sprites
+            bsr     run_rules
+            bsr     sound_tick
+            bsr     flash_tick
+            rts
+
+read_joy:
+            move.w  $0c(a6),d0              ; JOY1DAT (port 2)
+            moveq   #0,d2
+            btst    #1,d0
+            beq.s   .nr
+            or.w    #8,d2                   ; right
+.nr         btst    #9,d0
+            beq.s   .nl
+            or.w    #4,d2                   ; left
+.nl         move.w  d0,d1
+            lsr.w   #1,d1
+            eor.w   d0,d1
+            btst    #0,d1
+            beq.s   .nd
+            or.w    #2,d2                   ; down
+.nd         btst    #8,d1
+            beq.s   .nu
+            or.w    #1,d2                   ; up
+.nu         btst    #7,$bfe001
+            bne.s   .nf
+            or.w    #16,d2                  ; fire (port 2)
+.nf         move.w  d2,v_joy(a5)
+            rts
+
+; ============================================================================
+;  actor movement
+; ============================================================================
+move_actors:
+            move.w  H_NACT(a4),d6
+            beq     .done
+            move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a2
+            moveq   #0,d7
+.loop       move.w  d7,d5
+            add.w   d5,d5
+            move.w  A_ROLE(a2),d0
+            beq.s   .player
+            cmp.w   #4,d0
+            beq     .chaser
+            cmp.w   #3,d0
+            beq     .vert
+            cmp.w   #2,d0
+            beq.s   .horiz
+            cmp.w   #1,d0
+            beq.s   .horiz
+            bra     .next
+
+.player     move.w  v_spd(a5,d5.w),d1
+            move.w  v_joy(a5),d2
+            btst    #0,d2
+            beq.s   .pu
+            move.w  v_ay(a5,d5.w),d0
+            sub.w   d1,d0
+            bge.s   .pu1
+            moveq   #0,d0
+.pu1        move.w  d0,v_ay(a5,d5.w)
+.pu         btst    #1,d2
+            beq.s   .pd
+            move.w  v_ay(a5,d5.w),d0
+            add.w   d1,d0
+            cmp.w   #YMAX,d0
+            ble.s   .pd1
+            move.w  #YMAX,d0
+.pd1        move.w  d0,v_ay(a5,d5.w)
+.pd         btst    #2,d2
+            beq.s   .pl
+            move.w  v_ax(a5,d5.w),d0
+            sub.w   d1,d0
+            bge.s   .pl1
+            moveq   #0,d0
+.pl1        move.w  d0,v_ax(a5,d5.w)
+.pl         btst    #3,d2
+            beq.s   .pr
+            move.w  v_ax(a5,d5.w),d0
+            add.w   d1,d0
+            cmp.w   #XMAX,d0
+            ble.s   .pr1
+            move.w  #XMAX,d0
+.pr1        move.w  d0,v_ax(a5,d5.w)
+.pr         bra     .next
+
+.horiz      move.w  v_spd(a5,d5.w),d1
+            move.w  v_ax(a5,d5.w),d0
+            tst.w   v_dx(a5,d5.w)
+            bne.s   .hl
+            add.w   d1,d0
+            cmp.w   #XMAX,d0
+            ble.s   .hs
+            move.w  #XMAX,d0
+            move.w  #1,v_dx(a5,d5.w)
+            bra.s   .hs
+.hl         sub.w   d1,d0
+            bge.s   .hs
+            moveq   #0,d0
+            move.w  #0,v_dx(a5,d5.w)
+.hs         move.w  d0,v_ax(a5,d5.w)
+            cmp.w   #1,A_ROLE(a2)           ; bouncer also moves vertically
+            bne     .next
+
+.vert       move.w  v_spd(a5,d5.w),d1
+            move.w  v_ay(a5,d5.w),d0
+            tst.w   v_dy(a5,d5.w)
+            bne.s   .vu
+            add.w   d1,d0
+            cmp.w   #YMAX,d0
+            ble.s   .vs
+            move.w  #YMAX,d0
+            move.w  #1,v_dy(a5,d5.w)
+            bra.s   .vs
+.vu         sub.w   d1,d0
+            bge.s   .vs
+            moveq   #0,d0
+            move.w  #0,v_dy(a5,d5.w)
+.vs         move.w  d0,v_ay(a5,d5.w)
+            bra.s   .next
+
+.chaser     move.w  H_PLAYER(a4),d4
+            bge.s   .ct
+            moveq   #0,d4
+.ct         cmp.w   d7,d4
+            beq.s   .next
+            add.w   d4,d4
+            move.w  v_spd(a5,d5.w),d3
+            subq.w  #1,d3
+            bmi.s   .next
+.cl         move.w  v_ax(a5,d5.w),d0
+            cmp.w   v_ax(a5,d4.w),d0
+            beq.s   .cy
+            blt.s   .cxi
+            subq.w  #1,v_ax(a5,d5.w)
+            bra.s   .cy
+.cxi        addq.w  #1,v_ax(a5,d5.w)
+.cy         move.w  v_ay(a5,d5.w),d0
+            cmp.w   v_ay(a5,d4.w),d0
+            beq.s   .cn
+            blt.s   .cyi
+            subq.w  #1,v_ay(a5,d5.w)
+            bra.s   .cn
+.cyi        addq.w  #1,v_ay(a5,d5.w)
+.cn         dbf     d3,.cl
+
+.next       lea     ACT_SIZE(a2),a2
+            addq.w  #1,d7
+            cmp.w   d6,d7
+            blt     .loop
+.done       rts
+
+; ============================================================================
+;  write every actor's sprite control words
+; ============================================================================
+place_sprites:
+            move.w  H_NACT(a4),d6
+            beq.s   .done
+            move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a2
+            moveq   #0,d7
+.loop       move.w  d7,d5
+            add.w   d5,d5
+            move.l  A_SPR(a2),d0
+            lea     0(a4,d0.l),a0
+            tst.w   v_vis(a5,d5.w)
+            bne.s   .show
+            move.l  #0,(a0)
+            bra.s   .next
+.show       move.w  v_ay(a5,d5.w),d0
+            add.w   #$2c,d0                 ; VSTART
+            move.w  v_ax(a5,d5.w),d1
+            add.w   #128,d1                 ; HSTART
+            move.w  d0,d2
+            add.w   #SPR_H,d2               ; VSTOP
+            move.w  d0,d3
+            lsl.w   #8,d3
+            move.w  d1,d4
+            lsr.w   #1,d4
+            and.w   #$ff,d4
+            or.w    d4,d3
+            move.w  d3,(a0)                 ; SPRxPOS
+            move.w  d2,d3
+            lsl.w   #8,d3
+            btst    #8,d0
+            beq.s   .c1
+            or.w    #4,d3
+.c1         btst    #8,d2
+            beq.s   .c2
+            or.w    #2,d3
+.c2         btst    #0,d1
+            beq.s   .c3
+            or.w    #1,d3
+.c3         move.w  d3,2(a0)                ; SPRxCTL
+.next       lea     ACT_SIZE(a2),a2
+            addq.w  #1,d7
+            cmp.w   d6,d7
+            blt.s   .loop
+.done       rts
+
+hide_sprites:
+            move.w  H_NACT(a4),d6
+            beq.s   .done
+            move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a2
+            subq.w  #1,d6
+.h          move.l  A_SPR(a2),d0
+            lea     0(a4,d0.l),a0
+            move.l  #0,(a0)
+            lea     ACT_SIZE(a2),a2
+            dbf     d6,.h
+.done       rts
+
+; ============================================================================
+;  collisions - bounding boxes trimmed to each sprite's drawn pixels
+;  touch:      d0.w = actor a, d1.w = actor b  -> d0 = 1 and NE when touching
+;  touch_any:  d0.w = actor a                  -> any other visible actor
+; ============================================================================
+touch_pair:
+            movem.l d2-d5/a0-a1,-(sp)
+            move.w  H_NACT(a4),d2
+            cmp.w   d2,d0
+            bhs     .no
+            cmp.w   d2,d1
+            bhs     .no
+            move.l  H_ACTORS(a4),d2
+            lea     0(a4,d2.l),a0
+            move.l  a0,a1
+            move.w  d0,d4
+            lsl.w   #5,d4
+            add.w   d4,a0                   ; record a
+            move.w  d1,d4
+            lsl.w   #5,d4
+            add.w   d4,a1                   ; record b
+            move.w  d0,d4
+            add.w   d4,d4
+            move.w  d1,d5
+            add.w   d5,d5
+            tst.w   v_vis(a5,d4.w)
+            beq.s   .no
+            tst.w   v_vis(a5,d5.w)
+            beq.s   .no
+            move.w  v_ax(a5,d4.w),d2        ; a.left > b.right ?
+            add.w   A_BX0(a0),d2
+            move.w  v_ax(a5,d5.w),d3
+            add.w   A_BX1(a1),d3
+            cmp.w   d3,d2
+            bgt.s   .no
+            move.w  v_ax(a5,d5.w),d2        ; b.left > a.right ?
+            add.w   A_BX0(a1),d2
+            move.w  v_ax(a5,d4.w),d3
+            add.w   A_BX1(a0),d3
+            cmp.w   d3,d2
+            bgt.s   .no
+            move.w  v_ay(a5,d4.w),d2        ; a.top > b.bottom ?
+            add.w   A_BY0(a0),d2
+            move.w  v_ay(a5,d5.w),d3
+            add.w   A_BY1(a1),d3
+            cmp.w   d3,d2
+            bgt.s   .no
+            move.w  v_ay(a5,d5.w),d2        ; b.top > a.bottom ?
+            add.w   A_BY0(a1),d2
+            move.w  v_ay(a5,d4.w),d3
+            add.w   A_BY1(a0),d3
+            cmp.w   d3,d2
+            bgt.s   .no
+            moveq   #1,d0
+            bra.s   .out
+.no         moveq   #0,d0
+.out        movem.l (sp)+,d2-d5/a0-a1
+            tst.w   d0
+            rts
+
+touch_any:
+            movem.l d1/d6-d7,-(sp)
+            move.w  d0,d6                   ; actor a
+            moveq   #0,d7
+.t          cmp.w   H_NACT(a4),d7
+            bge.s   .none
+            cmp.w   d6,d7
+            beq.s   .skip
+            move.w  d6,d0
+            move.w  d7,d1
+            bsr     touch_pair
+            bne.s   .hit
+.skip       addq.w  #1,d7
+            bra.s   .t
+.none       moveq   #0,d0
+            bra.s   .out
+.hit        moveq   #1,d0
+.out        movem.l (sp)+,d1/d6-d7
+            tst.w   d0
+            rts
+
+; ============================================================================
+;  WHEN / DO rules
+; ============================================================================
+run_rules:
+            move.w  H_NRULE(a4),d6
+            beq     .done
+            move.l  H_RULES(a4),d0
+            lea     0(a4,d0.l),a3
+            moveq   #0,d7
+.r          move.w  d7,d5
+            add.w   d5,d5                   ; latch offset
+            lea     v_latch(a5),a2
+            add.w   d5,a2                   ; a2 = this rule's latch
+            move.w  R_WHEN(a3),d0
+            beq.s   .touch
+            cmp.w   #1,d0
+            beq.s   .fire
+            cmp.w   #2,d0
+            beq.s   .timer
+            cmp.w   #3,d0
+            beq     .score
+            cmp.w   #4,d0
+            beq     .lives
+            bra     .next
+
+.touch      move.w  R_A(a3),d0
+            move.w  R_B(a3),d1
+            cmp.w   d0,d1
+            bne.s   .two
+            bsr     touch_any
+            bra.s   .tt
+.two        bsr     touch_pair
+.tt         beq.s   .clear
+.edge       tst.w   (a2)
+            bne     .next
+            move.w  #1,(a2)
+            bsr     fire_action
+            bra     .next
+.clear      move.w  #0,(a2)
+            bra     .next
+
+.fire       btst    #4,v_joy+1(a5)
+            beq.s   .clear
+            bra.s   .edge
+
+.timer      tst.w   v_sectick(a5)
+            beq     .next
+            addq.w  #1,(a2)
+            move.w  (a2),d0
+            cmp.w   R_N(a3),d0
+            blt     .next
+            move.w  #0,(a2)
+            bsr     fire_action
+            bra     .next
+
+.score      tst.w   (a2)
+            bne     .next
+            moveq   #0,d0
+            move.w  R_N(a3),d0
+            cmp.l   v_score(a5),d0
+            bhi     .next
+            move.w  #1,(a2)
+            bsr     fire_action
+            bra     .next
+
+.lives      tst.w   v_lives(a5)
+            bne     .next
+            tst.w   (a2)
+            bne     .next
+            move.w  #1,(a2)
+            bsr     fire_action
+
+.next       lea     RULE_SIZE(a3),a3
+            addq.w  #1,d7
+            cmp.w   d6,d7
+            blt     .r
+.done       rts
+
+run_start_rules:
+            move.w  H_NRULE(a4),d6
+            beq.s   .done
+            move.l  H_RULES(a4),d0
+            lea     0(a4,d0.l),a3
+            moveq   #0,d7
+.r          cmp.w   #5,R_WHEN(a3)
+            bne.s   .n
+            bsr     fire_action
+.n          lea     RULE_SIZE(a3),a3
+            addq.w  #1,d7
+            cmp.w   d6,d7
+            blt.s   .r
+.done       rts
+
+fire_action:
+            movem.l d5-d7/a2-a3,-(sp)
+            bsr     do_action
+            movem.l (sp)+,d5-d7/a2-a3
+            rts
+
+; a3 = rule
+do_action:
+            move.w  R_TGT(a3),d5            ; target actor -> d5 = offset
+            move.w  d5,d4
+            add.w   d5,d5
+            move.w  R_ACT(a3),d0
+            cmp.w   #13,d0
+            bhi     act_none
+            add.w   d0,d0
+            move.w  acttab(pc,d0.w),d0
+            jmp     acttab(pc,d0.w)
+acttab:     dc.w    act_score-acttab
+            dc.w    act_loselife-acttab
+            dc.w    act_sound-acttab
+            dc.w    act_flash-acttab
+            dc.w    act_home-acttab
+            dc.w    act_random-acttab
+            dc.w    act_hide-acttab
+            dc.w    act_show-acttab
+            dc.w    act_bgcol-acttab
+            dc.w    act_over-acttab
+            dc.w    act_win-acttab
+            dc.w    act_faster-acttab
+            dc.w    act_slower-acttab
+            dc.w    act_addlife-acttab
+
+act_none:   rts
+
+act_score:  moveq   #0,d0
+            move.w  R_VAL(a3),d0
+            add.l   v_score(a5),d0
+            cmp.l   #SCORE_MAX,d0
+            bls.s   .ok
+            move.l  #SCORE_MAX,d0
+.ok         move.l  d0,v_score(a5)
+            bra     draw_hud
+
+act_loselife:
+            tst.w   v_lives(a5)
+            beq.s   .z
+            subq.w  #1,v_lives(a5)
+.z          bra     draw_hud
+
+act_addlife:
+            cmp.w   #9,v_lives(a5)
+            bhs.s   .z
+            addq.w  #1,v_lives(a5)
+.z          bra     draw_hud
+
+act_sound:  move.w  R_VAL(a3),d0
+            and.w   #7,d0
+            bra     play_sfx
+
+act_flash:  move.w  #16,v_flash(a5)
+            rts
+
+act_home:   cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            bsr     actor_rec
+            move.w  A_X(a0),v_ax(a5,d5.w)
+            move.w  A_Y(a0),v_ay(a5,d5.w)
+            rts
+
+act_random: cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            bsr     rand
+            and.l   #$ffff,d0
+            divu    #XMAX+1,d0
+            swap    d0
+            move.w  d0,v_ax(a5,d5.w)
+            bsr     rand
+            and.l   #$ffff,d0
+            divu    #YMAX+1-16,d0
+            swap    d0
+            add.w   #16,d0                  ; keep clear of the top row
+            move.w  d0,v_ay(a5,d5.w)
+            rts
+
+act_hide:   cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            move.w  #0,v_vis(a5,d5.w)
+            rts
+
+act_show:   cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            move.w  #1,v_vis(a5,d5.w)
+            rts
+
+act_bgcol:  move.w  R_VAL(a3),d0
+            move.w  H_DEPTH(a4),d6
+            moveq   #1,d1
+            lsl.w   d6,d1
+            cmp.w   d1,d0
+            bhs     act_none
+            move.l  H_PAL(a4),d1
+            lea     0(a4,d1.l),a0
+            add.w   d0,d0
+            add.w   d0,d0
+            move.l  0(a0,d0.w),d1
+            move.l  d1,v_bg(a5)
+            moveq   #0,d0
+            bra     setcol
+
+act_faster: cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            cmp.w   #8,v_spd(a5,d5.w)
+            bhs.s   .z
+            addq.w  #1,v_spd(a5,d5.w)
+.z          rts
+
+act_slower: cmp.w   H_NACT(a4),d4
+            bhs     act_none
+            cmp.w   #1,v_spd(a5,d5.w)
+            bls.s   .z
+            subq.w  #1,v_spd(a5,d5.w)
+.z          rts
+
+act_over:   move.l  H_TOVER(a4),d0
+            lea     0(a4,d0.l),a0
+            bra.s   end_screen
+act_win:    move.l  H_TWIN(a4),d0
+            lea     0(a4,d0.l),a0
+
+; a0 = message.  Shows it, waits for fire, then restarts the game.
+end_screen:
+            move.w  #$000f,$96(a6)          ; audio off
+            move.l  a0,-(sp)
+            bsr     hide_sprites
+            move.l  (sp)+,a0
+            moveq   #0,d0
+            move.l  v_bg(a5),d1
+            bsr     setcol
+            move.l  a0,a1                   ; centre the text
+            moveq   #0,d1
+.len        tst.b   (a1)+
+            beq.s   .lend
+            addq.w  #1,d1
+            bra.s   .len
+.lend       cmp.w   #40,d1
+            bls.s   .lok
+            moveq   #40,d1
+.lok        neg.w   d1
+            add.w   #40,d1
+            lsr.w   #1,d1
+            subq.w  #1,d1                   ; one space of box either side
+            moveq   #15,d2
+            move.w  H_MSGCOL(a4),d3
+            move.w  #1,v_opaque(a5)
+            moveq   #' ',d0
+            bsr     draw_char
+            addq.w  #1,d1
+            bsr     draw_text
+            move.l  a0,a1
+.end        tst.b   (a1)+
+            beq.s   .endd
+            addq.w  #1,d1
+            bra.s   .end
+.endd       moveq   #' ',d0
+            bsr     draw_char
+            move.w  #0,v_opaque(a5)
+.wr         bsr     wait_vbl                ; fire released...
+            btst    #7,$bfe001
+            beq.s   .wr
+.wp         bsr     wait_vbl                ; ...pressed...
+            btst    #7,$bfe001
+            bne.s   .wp
+.wu         bsr     wait_vbl                ; ...and released again
+            btst    #7,$bfe001
+            beq.s   .wu
+            bra     game_restart
+
+; d4 = actor index -> a0 = actor record
+actor_rec:  move.l  H_ACTORS(a4),d0
+            lea     0(a4,d0.l),a0
+            move.w  d4,d0
+            lsl.w   #5,d0
+            add.w   d0,a0
+            rts
+
+; xorshift32 -> d0.l
+rand:       move.l  d1,-(sp)
+            move.l  v_rand(a5),d0
+            move.l  d0,d1
+            lsl.l   #8,d1
+            lsl.l   #5,d1
+            eor.l   d1,d0
+            move.l  d0,d1
+            clr.w   d1
+            swap    d1
+            lsr.l   #1,d1
+            eor.l   d1,d0
+            move.l  d0,d1
+            lsl.l   #5,d1
+            eor.l   d1,d0
+            move.l  d0,v_rand(a5)
+            move.l  (sp)+,d1
+            rts
+
+; ============================================================================
+;  border-style screen flash on colour 0
+; ============================================================================
+flash_tick:
+            move.w  v_flash(a5),d0
+            beq.s   .r
+            subq.w  #1,d0
+            move.w  d0,v_flash(a5)
+            beq.s   .restore
+            btst    #1,d0
+            beq.s   .restore
+            moveq   #0,d0
+            move.l  #$ffffff,d1
+            bra     setcol
+.restore    moveq   #0,d0
+            move.l  v_bg(a5),d1
+            bra     setcol
+.r          rts
+
+; ============================================================================
+;  Paula sound effects - one shot, channel = sound number AND 3
+; ============================================================================
+play_sfx:
+            movem.l d0-d4/a0-a2,-(sp)
+            move.l  H_SFX(a4),d1
+            lea     0(a4,d1.l),a0
+            move.w  d0,d1
+            lsl.w   #3,d1
+            add.w   d1,a0
+            move.w  4(a0),d2                ; length in words
+            beq.s   .out
+            move.l  (a0),d1
+            add.l   a4,d1                   ; sample address
+            move.w  d0,d3
+            and.w   #3,d3
+            moveq   #1,d4
+            lsl.w   d3,d4
+            move.w  d4,$96(a6)              ; channel DMA off
+            move.w  d3,d4
+            lsl.w   #4,d4
+            lea     $a0(a6),a1
+            add.w   d4,a1
+            move.l  d1,(a1)                 ; AUDxLC
+            move.w  d2,4(a1)                ; AUDxLEN
+            move.w  #SFX_PERIOD,6(a1)       ; AUDxPER
+            move.w  #64,8(a1)               ; AUDxVOL
+            lea     v_spend(a5),a2
+            add.w   d3,d3
+            move.w  #2,0(a2,d3.w)
+.out        movem.l (sp)+,d0-d4/a0-a2
+            rts
+
+sound_tick:
+            lea     v_spend(a5),a2
+            lea     $a0(a6),a1
+            moveq   #0,d3
+.c          move.w  (a2),d0
+            beq.s   .n
+            cmp.w   #2,d0
+            bne.s   .stop
+            moveq   #1,d4                   ; start the sample
+            lsl.w   d3,d4
+            or.w    #$8000,d4
+            move.w  d4,$96(a6)
+            move.w  #1,(a2)
+            bra.s   .n
+.stop       lea     silence(pc),a0          ; then loop silence
+            move.l  a0,(a1)
+            move.w  #1,4(a1)
+            move.w  #0,(a2)
+.n          addq.l  #2,a2
+            lea     16(a1),a1
+            addq.w  #1,d3
+            cmp.w   #4,d3
+            blt.s   .c
+            rts
+
+; ============================================================================
+;  text  (8 x 8 font, 40 columns x 32 rows, drawn into the bitplanes)
+;  draw_text:  a0 = string, d1 = column, d2 = row, d3 = palette index
+;  draw_char:  d0 = character, d1 = column, d2 = row, d3 = palette index
+; ============================================================================
+draw_text:
+            movem.l d0-d1/a0,-(sp)
+.c          moveq   #0,d0
+            move.b  (a0)+,d0
+            beq.s   .done
+            cmp.w   #40,d1
+            bhs.s   .done
+            bsr     draw_char
+            addq.w  #1,d1
+            bra.s   .c
+.done       movem.l (sp)+,d0-d1/a0
+            rts
+
+draw_char:
+            movem.l d0-d7/a0-a3,-(sp)
+            and.w   #$ff,d0
+            cmp.w   #96,d0                  ; fold lower case
+            blo.s   .up
+            sub.w   #32,d0
+.up         cmp.w   #32,d0
+            blo.s   .sp
+            cmp.w   #96,d0
+            blo.s   .ok
+.sp         moveq   #32,d0
+.ok         sub.w   #32,d0
+            lsl.w   #3,d0
+            lea     font(pc),a1
+            add.w   d0,a1                   ; glyph
+            move.w  d2,d4
+            mulu    #320,d4
+            add.w   d1,d4                   ; byte offset of the cell
+            move.l  v_disp(a5),a2
+            add.l   d4,a2
+            move.l  H_PLANES(a4),d5
+            lea     0(a4,d5.l),a3
+            add.l   d4,a3                   ; pristine backdrop under the cell
+            move.w  H_DEPTH(a4),d6
+            subq.w  #1,d6
+            moveq   #0,d5                   ; plane number
+.plane      move.l  a1,a0
+            moveq   #7,d7
+.line       move.b  (a0)+,d0                ; glyph bits
+            moveq   #0,d1                   ; opaque text: colour 0 box
+            tst.w   v_opaque(a5)
+            bne.s   .bg
+            move.b  (a3),d1                 ; background
+.bg
+            move.b  d0,d2
+            not.b   d2
+            and.b   d2,d1
+            btst    d5,d3
+            beq.s   .clr
+            or.b    d0,d1
+.clr        move.b  d1,(a2)
+            lea     40(a2),a2
+            lea     40(a3),a3
+            dbf     d7,.line
+            add.l   #PLANE_SIZE-320,a2
+            add.l   #PLANE_SIZE-320,a3
+            addq.w  #1,d5
+            dbf     d6,.plane
+            movem.l (sp)+,d0-d7/a0-a3
+            rts
+
+draw_hud:
+            movem.l d0-d3/a0,-(sp)
+            move.w  H_HUDROW(a4),d2
+            move.w  H_HUDCOL(a4),d3
+            tst.w   H_SHOWSC(a4)
+            beq.s   .nosc
+            lea     str_score(pc),a0
+            moveq   #1,d1
+            bsr     draw_text
+            move.l  v_score(a5),d0          ; 5 decimal digits
+            lea     v_digits+5(a5),a0
+            move.b  #0,(a0)
+            moveq   #4,d1
+.dg         divu    #10,d0
+            swap    d0
+            add.b   #'0',d0
+            move.b  d0,-(a0)
+            clr.w   d0
+            swap    d0
+            dbf     d1,.dg
+            moveq   #7,d1
+            bsr     draw_text
+.nosc       tst.w   H_SHOWLV(a4)
+            beq.s   .nolv
+            lea     str_lives(pc),a0
+            moveq   #31,d1
+            bsr     draw_text
+            moveq   #'0',d0
+            add.w   v_lives(a5),d0
+            moveq   #37,d1
+            bsr     draw_char
+.nolv       movem.l (sp)+,d0-d3/a0
+            rts
+
+str_score:  dc.b    "SCORE ",0
+str_lives:  dc.b    "LIVES ",0
+            even
+
+font:
+            include "font.inc"
+
+; ============================================================================
+;  chip data
+; ============================================================================
+            cnop    0,8
+silence:    dc.w    0,0
+null_spr:   dc.l    0,0
+
+copper:
+cop_bpl:    dc.w    $00e0,0,$00e2,0
+            dc.w    $00e4,0,$00e6,0
+            dc.w    $00e8,0,$00ea,0
+            dc.w    $00ec,0,$00ee,0
+            dc.w    $00f0,0,$00f2,0
+            dc.w    $00f4,0,$00f6,0
+            dc.w    $00f8,0,$00fa,0
+            dc.w    $00fc,0,$00fe,0
+cop_spr:    dc.w    $0120,0,$0122,0
+            dc.w    $0124,0,$0126,0
+            dc.w    $0128,0,$012a,0
+            dc.w    $012c,0,$012e,0
+            dc.w    $0130,0,$0132,0
+            dc.w    $0134,0,$0136,0
+            dc.w    $0138,0,$013a,0
+            dc.w    $013c,0,$013e,0
+            dc.w    $ffff,$fffe
+
+            cnop    0,4
+V:          ds.b    V_SIZE
+            cnop    0,4
+stack:      ds.b    2048
+stack_top:
+            cnop    0,8
+data_start:
diff --git a/datafiles/engine/font.inc b/datafiles/engine/font.inc
new file mode 100644
index 0000000..0049f23
--- /dev/null
+++ b/datafiles/engine/font.inc
@@ -0,0 +1,64 @@
+ dc.b $00,$00,$00,$00,$00,$00,$00,$00	; ' '
+ dc.b $18,$3c,$3c,$18,$18,$00,$18,$00	; '!'
+ dc.b $6c,$6c,$00,$00,$00,$00,$00,$00	; '"'
+ dc.b $6c,$6c,$fe,$6c,$fe,$6c,$6c,$00	; '#'
+ dc.b $30,$7c,$c0,$78,$0c,$f8,$30,$00	; '$'
+ dc.b $00,$c6,$cc,$18,$30,$66,$c6,$00	; '%'
+ dc.b $38,$6c,$38,$76,$dc,$cc,$76,$00	; '&'
+ dc.b $60,$60,$c0,$00,$00,$00,$00,$00	; "'"
+ dc.b $18,$30,$60,$60,$60,$30,$18,$00	; '('
+ dc.b $60,$30,$18,$18,$18,$30,$60,$00	; ')'
+ dc.b $00,$66,$3c,$ff,$3c,$66,$00,$00	; '*'
+ dc.b $00,$30,$30,$fc,$30,$30,$00,$00	; '+'
+ dc.b $00,$00,$00,$00,$00,$30,$30,$60	; ','
+ dc.b $00,$00,$00,$fc,$00,$00,$00,$00	; '-'
+ dc.b $00,$00,$00,$00,$00,$30,$30,$00	; '.'
+ dc.b $06,$0c,$18,$30,$60,$c0,$80,$00	; '/'
+ dc.b $7c,$c6,$ce,$de,$f6,$e6,$7c,$00	; '0'
+ dc.b $30,$70,$30,$30,$30,$30,$fc,$00	; '1'
+ dc.b $78,$cc,$0c,$38,$60,$cc,$fc,$00	; '2'
+ dc.b $78,$cc,$0c,$38,$0c,$cc,$78,$00	; '3'
+ dc.b $1c,$3c,$6c,$cc,$fe,$0c,$1e,$00	; '4'
+ dc.b $fc,$c0,$f8,$0c,$0c,$cc,$78,$00	; '5'
+ dc.b $38,$60,$c0,$f8,$cc,$cc,$78,$00	; '6'
+ dc.b $fc,$cc,$0c,$18,$30,$30,$30,$00	; '7'
+ dc.b $78,$cc,$cc,$78,$cc,$cc,$78,$00	; '8'
+ dc.b $78,$cc,$cc,$7c,$0c,$18,$70,$00	; '9'
+ dc.b $00,$30,$30,$00,$00,$30,$30,$00	; ':'
+ dc.b $00,$30,$30,$00,$00,$30,$30,$60	; ';'
+ dc.b $18,$30,$60,$c0,$60,$30,$18,$00	; '<'
+ dc.b $00,$00,$fc,$00,$00,$fc,$00,$00	; '='
+ dc.b $60,$30,$18,$0c,$18,$30,$60,$00	; '>'
+ dc.b $78,$cc,$0c,$18,$30,$00,$30,$00	; '?'
+ dc.b $7c,$c6,$de,$de,$de,$c0,$78,$00	; '@'
+ dc.b $30,$78,$cc,$cc,$fc,$cc,$cc,$00	; 'A'
+ dc.b $fc,$66,$66,$7c,$66,$66,$fc,$00	; 'B'
+ dc.b $3c,$66,$c0,$c0,$c0,$66,$3c,$00	; 'C'
+ dc.b $f8,$6c,$66,$66,$66,$6c,$f8,$00	; 'D'
+ dc.b $fe,$62,$68,$78,$68,$62,$fe,$00	; 'E'
+ dc.b $fe,$62,$68,$78,$68,$60,$f0,$00	; 'F'
+ dc.b $3c,$66,$c0,$c0,$ce,$66,$3e,$00	; 'G'
+ dc.b $cc,$cc,$cc,$fc,$cc,$cc,$cc,$00	; 'H'
+ dc.b $78,$30,$30,$30,$30,$30,$78,$00	; 'I'
+ dc.b $1e,$0c,$0c,$0c,$cc,$cc,$78,$00	; 'J'
+ dc.b $e6,$66,$6c,$78,$6c,$66,$e6,$00	; 'K'
+ dc.b $f0,$60,$60,$60,$62,$66,$fe,$00	; 'L'
+ dc.b $c6,$ee,$fe,$fe,$d6,$c6,$c6,$00	; 'M'
+ dc.b $c6,$e6,$f6,$de,$ce,$c6,$c6,$00	; 'N'
+ dc.b $38,$6c,$c6,$c6,$c6,$6c,$38,$00	; 'O'
+ dc.b $fc,$66,$66,$7c,$60,$60,$f0,$00	; 'P'
+ dc.b $78,$cc,$cc,$cc,$dc,$78,$1c,$00	; 'Q'
+ dc.b $fc,$66,$66,$7c,$6c,$66,$e6,$00	; 'R'
+ dc.b $78,$cc,$e0,$70,$1c,$cc,$78,$00	; 'S'
+ dc.b $fc,$b4,$30,$30,$30,$30,$78,$00	; 'T'
+ dc.b $cc,$cc,$cc,$cc,$cc,$cc,$fc,$00	; 'U'
+ dc.b $cc,$cc,$cc,$cc,$cc,$78,$30,$00	; 'V'
