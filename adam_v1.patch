diff --git a/shaders/sh_palette/sh_palette.fsh b/shaders/sh_palette/sh_palette.fsh
new file mode 100644
index 0000000..08c5dca
--- /dev/null
+++ b/shaders/sh_palette/sh_palette.fsh
@@ -0,0 +1,24 @@
+//
+// ADAM - draws a palette-index surface through the Amiga palette.
+// The colour index is stored in the red OR blue channel (the other is 0),
+// so the result is the same whichever byte order the surface uses.
+//
+varying vec2 v_vTexcoord;
+varying vec4 v_vColour;
+
+uniform vec3 u_pal[128];
+
+void main()
+{
+    vec4 t = texture2D(gm_BaseTexture, v_vTexcoord);
+    float idx = floor((t.r + t.b) * 255.0 + 0.5);
+    vec3 c = u_pal[0];
+    for (int k = 1; k < 128; k++)
+    {
+        if (float(k) == idx)
+        {
+            c = u_pal[k];
+        }
+    }
+    gl_FragColor = vec4(c, v_vColour.a);
+}
diff --git a/shaders/sh_palette/sh_palette.vsh b/shaders/sh_palette/sh_palette.vsh
new file mode 100644
index 0000000..c87af8b
--- /dev/null
+++ b/shaders/sh_palette/sh_palette.vsh
@@ -0,0 +1,17 @@
+//
+// ADAM - passthrough vertex shader for the palette-indexed backdrop
+//
+attribute vec3 in_Position;
+attribute vec4 in_Colour;
+attribute vec2 in_TextureCoord;
+
+varying vec2 v_vTexcoord;
+varying vec4 v_vColour;
+
+void main()
+{
+    vec4 object_space_pos = vec4(in_Position.x, in_Position.y, in_Position.z, 1.0);
+    gl_Position = gm_Matrices[MATRIX_WORLD_VIEW_PROJECTION] * object_space_pos;
+    v_vColour = in_Colour;
+    v_vTexcoord = in_TextureCoord;
+}
