     ui_text_wrap(_x, _y, _intro, global.TH.text, _w, global.f_body, _a);
     _y += ceil(ui_sh_ext(_intro, _w)) + 24;
     var _how = "ADAM Pro is a separate download on itch.io. Your projects open in either one.";
